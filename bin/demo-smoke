#!/usr/bin/env bash
# Smoke check for the three demo entry points.
#
# Runs each demo end to end and asserts the beats the audience is supposed to
# see are actually in the output — so demo rot fails loudly instead of showing
# up live. Deliberately independent of the minitest/cucumber suites: it shells
# out to the same bin/demo-* scripts a presenter runs.
#
#   bin/demo-smoke            # all demos + mlr-doc
#   bin/demo-smoke overlay    # one of: overlay, prc-migration, prc, mlr-doc
set -uo pipefail
cd "$(dirname "$0")/.." || exit 1
ROOT="$PWD"

only="${1:-all}"
case "$only" in
  all | overlay | prc-migration | prc | mlr-doc) ;;
  *)
    printf 'demo-smoke: unknown demo: %s (one of: overlay, prc-migration, prc, mlr-doc)\n' "$only" >&2
    exit 64
    ;;
esac
failures=0
tmp="$(mktemp -d)" || exit 1
trap 'rm -rf "$tmp"' EXIT

check() {
  local name="$1" script="$2"; shift 2
  if [ "$only" != "all" ] && [ "$only" != "$name" ]; then return 0; fi

  local log="$tmp/$name.log"
  printf '== smoke: %s\n' "$name"
  if ! "$script" >"$log" 2>&1; then
    printf '   FAIL: %s exited non-zero\n' "$script"
    tail -20 "$log" | sed 's/^/   | /'
    failures=$((failures + 1))
    return 0
  fi

  local missing=0 pattern
  for pattern in "$@"; do
    if ! grep -qF -- "$pattern" "$log"; then
      printf '   FAIL: expected output missing: %s\n' "$pattern"
      missing=1
    fi
  done
  if [ "$missing" -eq 1 ]; then
    failures=$((failures + 1))
  else
    printf '   ok (%s assertions)\n' "$#"
  fi
}

mlr_doc_write_pg_env() {
  OUT="$1" ruby -ruri -rshellwords -e '
    u = URI(ENV.fetch("DATABASE_URL", "postgres://postgres:postgres@localhost:5432/corvid_dummy_development"))
    decode = URI.method(:decode_www_form_component)
    user = u.user ? decode.call(u.user) : "postgres"
    pass = u.password ? decode.call(u.password) : "postgres"
    File.open(ENV.fetch("OUT"), "w") do |f|
      f.puts "PGHOST=#{Shellwords.shellescape(u.host || "localhost")}"
      f.puts "PGPORT=#{Shellwords.shellescape((u.port || 5432).to_s)}"
      f.puts "PGUSER=#{Shellwords.shellescape(user)}"
      f.puts "PGPASSWORD=#{Shellwords.shellescape(pass)}"
    end
  '
}

mlr_doc_test_database_name() {
  ruby -ryaml -e '
    cfg = YAML.load_file("test/dummy/config/database.yml", aliases: true)
    puts cfg.fetch("test").fetch("database")
  '
}

mlr_doc_log_tail() {
  local logfile="$1"
  tail -30 "$logfile" | sed -E \
    -e 's#postgres://[^[:space:]"'\'']*#[REDACTED]#g' \
    -e 's#(DATABASE_URL|PGPASSWORD)=[^[:space:]]*#\1=[REDACTED]#g' \
    | sed 's/^/   | /'
}

# Writes "absent" or a sha256 hex digest to $1. Fails (non-zero) on probe/connection errors.
mlr_doc_test_db_snapshot() {
  local outfile="$1"
  local test_db="$2"
  local errfile="$3"
  local snap_err="$tmp/mlr-doc-snapshot.err"

  export MLR_DOC_TEST_DB="$test_db"

  if command -v psql >/dev/null 2>&1; then
    if ! psql -d postgres -v ON_ERROR_STOP=1 -tAc "SELECT 1" >"$snap_err" 2>&1; then
      cat "$snap_err" >"$errfile"
      return 1
    fi
    if ! psql -d postgres -v ON_ERROR_STOP=1 -tAc \
      "SELECT 1 FROM pg_database WHERE datname = '${test_db}'" >"$tmp/mlr-doc-db-exists.txt" 2>"$snap_err"; then
      cat "$snap_err" >"$errfile"
      return 1
    fi
    if [ "$(tr -d '[:space:]' <"$tmp/mlr-doc-db-exists.txt")" != "1" ]; then
      printf '%s\n' absent >"$outfile"
      return 0
    fi
    if ! psql -d "$test_db" -v ON_ERROR_STOP=1 -tAc \
      "SELECT version FROM schema_migrations ORDER BY version" >"$tmp/mlr-doc-migrations.txt" 2>"$snap_err"; then
      cat "$snap_err" >"$errfile"
      return 1
    fi
    if ! psql -d "$test_db" -v ON_ERROR_STOP=1 -tAc \
      "SELECT key, value, created_at, updated_at FROM ar_internal_metadata ORDER BY key" \
      >"$tmp/mlr-doc-metadata.txt" 2>"$snap_err"; then
      cat "$snap_err" >"$errfile"
      return 1
    fi
    if ! psql -d "$test_db" -v ON_ERROR_STOP=1 -tAc \
      "SELECT tablename FROM pg_tables WHERE schemaname = 'public' ORDER BY tablename" \
      >"$tmp/mlr-doc-tables.txt" 2>"$snap_err"; then
      cat "$snap_err" >"$errfile"
      return 1
    fi
    {
      printf '%s\n' 'schema_migrations'
      cat "$tmp/mlr-doc-migrations.txt"
      printf '%s\n' 'ar_internal_metadata'
      cat "$tmp/mlr-doc-metadata.txt"
      while IFS= read -r tbl; do
        [ -z "$tbl" ] && continue
        count="$(psql -d "$test_db" -v ON_ERROR_STOP=1 -tAc \
          "SELECT COUNT(*)::bigint FROM public.\"${tbl//\"/\"\"}\"" 2>"$snap_err")" || {
          cat "$snap_err" >"$errfile"
          return 1
        }
        printf '%s\t%s\n' "$tbl" "$(tr -d '[:space:]' <<<"$count")"
      done <"$tmp/mlr-doc-tables.txt"
    } | sha256sum | awk '{print $1}' >"$outfile"
    return 0
  fi

  if ! bundle exec ruby -rpg -rdigest -e '
    test_db = ENV.fetch("MLR_DOC_TEST_DB")
    conn = PG.connect(
      host: ENV.fetch("PGHOST"),
      port: ENV.fetch("PGPORT", "5432"),
      user: ENV.fetch("PGUSER"),
      password: ENV.fetch("PGPASSWORD"),
      dbname: "postgres"
    )
    exists = conn.exec_params("SELECT 1 FROM pg_database WHERE datname = $1", [test_db]).ntuples.positive?
    conn.close
    unless exists
      puts "absent"
      exit 0
    end
    conn = PG.connect(
      host: ENV.fetch("PGHOST"),
      port: ENV.fetch("PGPORT", "5432"),
      user: ENV.fetch("PGUSER"),
      password: ENV.fetch("PGPASSWORD"),
      dbname: test_db
    )
    parts = []
    mig = conn.exec("SELECT version FROM schema_migrations ORDER BY version")
    parts << "schema_migrations\n" + mig.map { |r| r["version"] }.join("\n")
    meta = conn.exec("SELECT key, value, created_at, updated_at FROM ar_internal_metadata ORDER BY key")
    parts << "ar_internal_metadata\n" + meta.map { |r| r.values.join("\t") }.join("\n")
    tables = conn.exec_params(
      "SELECT tablename FROM pg_tables WHERE schemaname = $1 ORDER BY tablename",
      ["public"]
    )
    tables.each do |row|
      tbl = row["tablename"]
      q = "SELECT COUNT(*)::bigint AS c FROM public." + conn.quote_ident(tbl)
      c = conn.exec(q).first["c"]
      parts << "#{tbl}\t#{c}"
    end
    conn.close
    puts Digest::SHA256.hexdigest(parts.join("\n"))
  ' >"$outfile" 2>"$snap_err"; then
    cat "$snap_err" >"$errfile"
    return 1
  fi
}

mlr_doc_assert_pass() {
  local logfile="$1"
  local pass_label="$2"
  local missing=0 pattern mlr_doc_pwd

  for pattern in "docs/gm6_mlr_savings_methodology.md." "savings=$"; do
    if ! grep -qF -- "$pattern" "$logfile"; then
      printf '   FAIL: pass %s expected output missing: %s\n' "$pass_label" "$pattern"
      missing=1
    fi
  done

  mlr_doc_pwd="$(grep '^MLR_DOC_PWD=' "$logfile" | tail -1)"
  if [ "$mlr_doc_pwd" != "MLR_DOC_PWD=$ROOT" ]; then
    printf '   FAIL: pass %s must end in repo root (expected MLR_DOC_PWD=%s, got %s)\n' \
      "$pass_label" "$ROOT" "${mlr_doc_pwd#MLR_DOC_PWD=}"
    missing=1
  fi

  return "$missing"
}

check_mlr_doc() {
  local name="mlr-doc"
  if [ "$only" != "all" ] && [ "$only" != "$name" ]; then return 0; fi

  local script="$tmp/mlr-doc-reproduce.sh"
  local doc="docs/gm6_mlr_savings_methodology.md"
  local log_a="$tmp/mlr-doc-pass-a.log"
  local log_b="$tmp/mlr-doc-pass-b.log"
  local snapshot_before="$tmp/mlr-doc-snapshot-before.txt"
  local snapshot_after="$tmp/mlr-doc-snapshot-after.txt"
  local snapshot_err="$tmp/mlr-doc-snapshot.err"
  local pg_env="$tmp/mlr-doc-pg.env"
  local test_db missing=0 assertions=0

  printf '== smoke: %s\n' "$name"

  if ! awk '
    BEGIN { after = 0; capturing = 0; got = 0 }
    /\*\*Reproduce:\*\*/ { after = 1; next }
    after && !got && /^```bash$/ { capturing = 1; got = 1; next }
    capturing && /^```$/ { capturing = 0; exit 0 }
    capturing { print }
    END { if (!got) exit 1 }
  ' "$doc" >"$tmp/mlr-doc-block.txt"; then
    printf '   FAIL: no ```bash block after **Reproduce:** in %s\n' "$doc"
    failures=$((failures + 1))
    return 0
  fi

  if [ ! -s "$tmp/mlr-doc-block.txt" ]; then
    printf '   FAIL: empty ```bash block after **Reproduce:** in %s\n' "$doc"
    failures=$((failures + 1))
    return 0
  fi

  if ! test_db="$(mlr_doc_test_database_name)"; then
    printf '   FAIL: could not read test database name from test/dummy/config/database.yml\n'
    failures=$((failures + 1))
    return 0
  fi

  if ! mlr_doc_write_pg_env "$pg_env"; then
    printf '   FAIL: could not parse DATABASE_URL server parameters\n'
    failures=$((failures + 1))
    return 0
  fi
  # shellcheck source=/dev/null
  set -a && . "$pg_env" && set +a

  if ! mlr_doc_test_db_snapshot "$snapshot_before" "$test_db" "$snapshot_err"; then
    printf '   FAIL: test database snapshot before reproduce (probe error)\n'
    sed -E \
      -e 's#postgres://[^[:space:]"'\'']*#[REDACTED]#g' \
      -e 's#(DATABASE_URL|PGPASSWORD)=[^[:space:]]*#\1=[REDACTED]#g' \
      "$snapshot_err" | sed 's/^/   | /'
    failures=$((failures + 1))
    return 0
  fi
  assertions=$((assertions + 1))

  {
    printf '%s\n' '#!/usr/bin/env bash'
    printf '%s\n' 'set -e'
    cat "$tmp/mlr-doc-block.txt"
    printf '%s\n' 'echo "MLR_DOC_PWD=$PWD"'
  } >"$script"
  chmod +x "$script"

  if ! env RAILS_ENV=test bash -e "$script" >"$log_a" 2>&1; then
    printf '   FAIL: reproduce block pass A (DATABASE_URL inherited) exited non-zero\n'
    mlr_doc_log_tail "$log_a"
    failures=$((failures + 1))
    return 0
  fi
  if ! mlr_doc_assert_pass "$log_a" A; then
    missing=1
  else
    assertions=$((assertions + 3))
  fi

  if ! env -u DATABASE_URL RAILS_ENV=test \
    PGHOST="$PGHOST" PGPORT="$PGPORT" PGUSER="$PGUSER" PGPASSWORD="$PGPASSWORD" \
    bash -e "$script" >"$log_b" 2>&1; then
    printf '   FAIL: reproduce block pass B (DATABASE_URL unset, TCP via PG*) exited non-zero\n'
    mlr_doc_log_tail "$log_b"
    failures=$((failures + 1))
    return 0
  fi
  if ! mlr_doc_assert_pass "$log_b" B; then
    missing=1
  else
    assertions=$((assertions + 3))
  fi

  if ! mlr_doc_test_db_snapshot "$snapshot_after" "$test_db" "$snapshot_err"; then
    printf '   FAIL: test database snapshot after reproduce (probe error)\n'
    sed -E \
      -e 's#postgres://[^[:space:]"'\'']*#[REDACTED]#g' \
      -e 's#(DATABASE_URL|PGPASSWORD)=[^[:space:]]*#\1=[REDACTED]#g' \
      "$snapshot_err" | sed 's/^/   | /'
    failures=$((failures + 1))
    return 0
  fi
  assertions=$((assertions + 1))

  if ! cmp -s "$snapshot_before" "$snapshot_after"; then
    printf '   FAIL: test database %s changed (snapshot before reproduce != after)\n' "$test_db"
    missing=1
  else
    assertions=$((assertions + 1))
  fi

  if [ "$missing" -eq 1 ]; then
    printf '   log tail pass A:\n'
    mlr_doc_log_tail "$log_a"
    printf '   log tail pass B:\n'
    mlr_doc_log_tail "$log_b"
    failures=$((failures + 1))
  else
    printf '   ok (%s assertions)\n' "$assertions"
  fi
}

# Narrated PRC happy path: referral walks the state machine to authorized with
# a funded obligation. Runs first on purpose: it shares the Broken Rock
# facility with the overlay, so the overlay's reset must clear what it leaves.
check prc bin/demo-prc \
  "1. Patient registration" \
  "3. Eligibility review + tribal enrollment verification" \
  "referral.approve_management!" \
  "funds_available=true" \
  "-> status=authorized" \
  "Checklist:      100.0% complete"

# Stock-FHIR overlay: both synthetic clinics ingest over generic FHIR, PRC
# eligibility auto-populates, and MLR repricing reports dollars recovered.
check overlay bin/demo-overlay \
  "Broken Rock Clinic" \
  "Tallgrass Clinic" \
  "Corvid::Adapters::FhirAdapter" \
  "PRC eligibility: checklist" \
  "Claims priced (clear): 10" \
  "TOTAL \$ RECOVERED across the consortium: \$" \
  "CEHRT-SAFE OVERLAY"

# Governed migration: consented patient relays, non-consented patient halts,
# both are recorded as audit Determinations.
check prc-migration bin/demo-prc-migration \
  "Transport: STUB" \
  "-> MIGRATED" \
  "-> HALTED    Data Governance Board consent not granted" \
  "determination approved" \
  "determination denied"

check_mlr_doc

if [ "$failures" -gt 0 ]; then
  printf '\ndemo-smoke: %d demo(s) failed\n' "$failures"
  exit 1
fi
if [ "$only" = "all" ]; then
  printf '\ndemo-smoke: all demos green\n'
else
  printf '\ndemo-smoke: %s green\n' "$only"
fi

#!/usr/bin/env bash
# Smoke check for the three demo entry points.
#
# Runs each demo end to end and asserts the beats the audience is supposed to
# see are actually in the output — so demo rot fails loudly instead of showing
# up live. Deliberately independent of the minitest/cucumber suites: it shells
# out to the same bin/demo-* scripts a presenter runs.
#
#   bin/demo-smoke            # all demos + mlr-doc
#   bin/demo-smoke overlay    # one of: overlay, prc-migration, prc, mlr-doc
set -uo pipefail
cd "$(dirname "$0")/.." || exit 1
ROOT="$PWD"

only="${1:-all}"
case "$only" in
  all | overlay | prc-migration | prc | mlr-doc) ;;
  *)
    printf 'demo-smoke: unknown demo: %s (one of: overlay, prc-migration, prc, mlr-doc)\n' "$only" >&2
    exit 64
    ;;
esac
failures=0
tmp="$(mktemp -d)" || exit 1
trap 'rm -rf "$tmp"' EXIT

check() {
  local name="$1" script="$2"; shift 2
  if [ "$only" != "all" ] && [ "$only" != "$name" ]; then return 0; fi

  local log="$tmp/$name.log"
  printf '== smoke: %s\n' "$name"
  if ! "$script" >"$log" 2>&1; then
    printf '   FAIL: %s exited non-zero\n' "$script"
    tail -20 "$log" | sed 's/^/   | /'
    failures=$((failures + 1))
    return 0
  fi

  local missing=0 pattern
  for pattern in "$@"; do
    if ! grep -qF -- "$pattern" "$log"; then
      printf '   FAIL: expected output missing: %s\n' "$pattern"
      missing=1
    fi
  done
  if [ "$missing" -eq 1 ]; then
    failures=$((failures + 1))
  else
    printf '   ok (%s assertions)\n' "$#"
  fi
}

mlr_doc_admin_database_url() {
  ruby -ruri -e '
    u = URI(ENV.fetch("DATABASE_URL", "postgres://postgres:postgres@localhost:5432/corvid_dummy_development"))
    u.path = "/postgres"
    puts u
  '
}

mlr_doc_canary_database_url() {
  ruby -ruri -e '
    u = URI(ENV.fetch("DATABASE_URL", "postgres://postgres:postgres@localhost:5432/corvid_dummy_development"))
    u.path = "/corvid_dummy_test_mlr_doc_canary"
    puts u
  '
}

mlr_doc_drop_canary() {
  local admin_url="$1"
  if command -v psql >/dev/null 2>&1; then
    psql "$admin_url" -v ON_ERROR_STOP=1 -tAc \
      "SELECT pg_terminate_backend(pid) FROM pg_stat_activity WHERE datname = 'corvid_dummy_test_mlr_doc_canary'" \
      >/dev/null 2>&1 || true
    psql "$admin_url" -v ON_ERROR_STOP=1 -tAc \
      "DROP DATABASE IF EXISTS corvid_dummy_test_mlr_doc_canary" \
      >/dev/null 2>&1 || true
    return 0
  fi
  bundle exec ruby -rpg -ruri -e "
    u = URI('$admin_url')
    conn = PG.connect(host: u.host, port: u.port || 5432, user: u.user, password: u.password, dbname: 'postgres')
    conn.exec(\"SELECT pg_terminate_backend(pid) FROM pg_stat_activity WHERE datname = 'corvid_dummy_test_mlr_doc_canary'\")
    conn.exec('DROP DATABASE IF EXISTS corvid_dummy_test_mlr_doc_canary')
  " >/dev/null 2>&1 || true
}

mlr_doc_canary_exists() {
  local admin_url="$1"
  if command -v psql >/dev/null 2>&1; then
    [ -n "$(psql "$admin_url" -v ON_ERROR_STOP=1 -tAc \
      "SELECT 1 FROM pg_database WHERE datname = 'corvid_dummy_test_mlr_doc_canary'")" ]
    return
  fi
  bundle exec ruby -rpg -ruri -e "
    u = URI('$admin_url')
    conn = PG.connect(host: u.host, port: u.port || 5432, user: u.user, password: u.password, dbname: 'postgres')
    r = conn.exec_params(\"SELECT 1 FROM pg_database WHERE datname = \$1\", ['corvid_dummy_test_mlr_doc_canary'])
    exit(r.ntuples.zero? ? 1 : 0)
  "
}

check_mlr_doc() {
  local name="mlr-doc"
  if [ "$only" != "all" ] && [ "$only" != "$name" ]; then return 0; fi

  local log="$tmp/$name.log"
  local script="$tmp/mlr-doc-reproduce.sh"
  local doc="docs/gm6_mlr_savings_methodology.md"
  local admin_url canary_url missing=0

  printf '== smoke: %s\n' "$name"

  if ! awk '
    BEGIN { after = 0; blocks = 0; capturing = 0 }
    /\*\*Reproduce:\*\*/ { after = 1; next }
    after && /^```bash$/ {
      blocks++
      if (blocks > 1) exit 2
      capturing = 1
      next
    }
    capturing && /^```$/ { capturing = 0; next }
    capturing { print }
    END { if (blocks != 1) exit 1 }
  ' "$doc" >"$tmp/mlr-doc-block.txt"; then
    printf '   FAIL: expected exactly one ```bash block after **Reproduce:** in %s\n' "$doc"
    failures=$((failures + 1))
    return 0
  fi

  {
    printf '%s\n' '#!/usr/bin/env bash'
    printf '%s\n' 'set -e'
    cat "$tmp/mlr-doc-block.txt"
    printf '%s\n' 'echo "MLR_DOC_PWD=$PWD"'
  } >"$script"
  chmod +x "$script"

  admin_url="$(mlr_doc_admin_database_url)"
  canary_url="$(mlr_doc_canary_database_url)"
  mlr_doc_drop_canary "$admin_url"

  if ! env RAILS_ENV=test DATABASE_URL="$canary_url" bash -e "$script" >"$log" 2>&1; then
    printf '   FAIL: reproduce block exited non-zero\n'
    tail -20 "$log" | sed 's/^/   | /'
    failures=$((failures + 1))
    return 0
  fi

  for pattern in "docs/gm6_mlr_savings_methodology.md." "savings=$"; do
    if ! grep -qF -- "$pattern" "$log"; then
      printf '   FAIL: expected output missing: %s\n' "$pattern"
      missing=1
    fi
  done

  mlr_doc_pwd="$(grep '^MLR_DOC_PWD=' "$log" | tail -1)"
  if [ "$mlr_doc_pwd" != "MLR_DOC_PWD=$ROOT" ]; then
    printf '   FAIL: reproduce block must end in repo root (expected MLR_DOC_PWD=%s, got %s)\n' \
      "$ROOT" "${mlr_doc_pwd#MLR_DOC_PWD=}"
    missing=1
  fi

  if mlr_doc_canary_exists "$admin_url"; then
    printf '   FAIL: canary database corvid_dummy_test_mlr_doc_canary exists (test-pointed database was touched)\n'
    missing=1
  fi

  if [ "$missing" -eq 1 ]; then
    tail -20 "$log" | sed 's/^/   | /'
    failures=$((failures + 1))
  else
    printf '   ok (4 assertions)\n'
  fi
}

# Narrated PRC happy path: referral walks the state machine to authorized with
# a funded obligation. Runs first on purpose: it shares the Broken Rock
# facility with the overlay, so the overlay's reset must clear what it leaves.
check prc bin/demo-prc \
  "1. Patient registration" \
  "3. Eligibility review + tribal enrollment verification" \
  "referral.approve_management!" \
  "funds_available=true" \
  "-> status=authorized" \
  "Checklist:      100.0% complete"

# Stock-FHIR overlay: both synthetic clinics ingest over generic FHIR, PRC
# eligibility auto-populates, and MLR repricing reports dollars recovered.
check overlay bin/demo-overlay \
  "Broken Rock Clinic" \
  "Tallgrass Clinic" \
  "Corvid::Adapters::FhirAdapter" \
  "PRC eligibility: checklist" \
  "Claims priced (clear): 10" \
  "TOTAL \$ RECOVERED across the consortium: \$" \
  "CEHRT-SAFE OVERLAY"

# Governed migration: consented patient relays, non-consented patient halts,
# both are recorded as audit Determinations.
check prc-migration bin/demo-prc-migration \
  "Transport: STUB" \
  "-> MIGRATED" \
  "-> HALTED    Data Governance Board consent not granted" \
  "determination approved" \
  "determination denied"

check_mlr_doc

if [ "$failures" -gt 0 ]; then
  printf '\ndemo-smoke: %d demo(s) failed\n' "$failures"
  exit 1
fi
if [ "$only" = "all" ]; then
  printf '\ndemo-smoke: all demos green\n'
else
  printf '\ndemo-smoke: %s green\n' "$only"
fi

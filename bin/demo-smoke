#!/usr/bin/env bash
# Smoke check for the three demo entry points.
#
# Runs each demo end to end and asserts the beats the audience is supposed to
# see are actually in the output — so demo rot fails loudly instead of showing
# up live. Deliberately independent of the minitest/cucumber suites: it shells
# out to the same bin/demo-* scripts a presenter runs.
#
#   bin/demo-smoke            # all demos + mlr-doc
#   bin/demo-smoke overlay    # one of: overlay, prc-migration, prc, mlr-doc
set -uo pipefail
cd "$(dirname "$0")/.." || exit 1
ROOT="$PWD"

only="${1:-all}"
case "$only" in
  all | overlay | prc-migration | prc | mlr-doc) ;;
  *)
    printf 'demo-smoke: unknown demo: %s (one of: overlay, prc-migration, prc, mlr-doc)\n' "$only" >&2
    exit 64
    ;;
esac
failures=0
tmp="$(mktemp -d)" || exit 1
trap 'rm -rf "$tmp"' EXIT

check() {
  local name="$1" script="$2"; shift 2
  if [ "$only" != "all" ] && [ "$only" != "$name" ]; then return 0; fi

  local log="$tmp/$name.log"
  printf '== smoke: %s\n' "$name"
  if ! "$script" >"$log" 2>&1; then
    printf '   FAIL: %s exited non-zero\n' "$script"
    tail -20 "$log" | mlr_doc_redact | sed 's/^/   | /'
    failures=$((failures + 1))
    return 0
  fi

  local missing=0 pattern
  for pattern in "$@"; do
    if ! grep -qF -- "$pattern" "$log"; then
      printf '   FAIL: expected output missing: %s\n' "$pattern"
      missing=1
    fi
  done
  if [ "$missing" -eq 1 ]; then
    failures=$((failures + 1))
  else
    printf '   ok (%s assertions)\n' "$#"
  fi
}

mlr_doc_write_pg_env() {
  # DATABASE_URL unset: keep the developer's PG* and only fill gaps.
  # URI::InvalidURIError echoes the raw URL, so rescue it and print a fixed line.
  OUT="$1" ruby -ruri -rshellwords -e '
    def write_env(host, port, user, pass)
      File.open(ENV.fetch("OUT"), "w") do |f|
        f.puts "PGHOST=#{Shellwords.shellescape(host.to_s)}"
        f.puts "PGPORT=#{Shellwords.shellescape(port.to_s)}"
        f.puts "PGUSER=#{Shellwords.shellescape(user.to_s)}"
        f.puts "PGPASSWORD=#{Shellwords.shellescape(pass.to_s)}"
      end
    end

    raw = ENV["DATABASE_URL"]
    if raw.nil? || raw.empty?
      write_env(
        ENV.fetch("PGHOST", "localhost"),
        ENV.fetch("PGPORT", "5432"),
        ENV.fetch("PGUSER", "postgres"),
        ENV.fetch("PGPASSWORD", "postgres")
      )
      exit 0
    end

    begin
      u = URI(raw)
      decode = URI.method(:decode_www_form_component)
      user = u.user ? decode.call(u.user) : "postgres"
      pass = u.password ? decode.call(u.password) : "postgres"
    rescue URI::InvalidURIError, ArgumentError
      abort "DATABASE_URL is not a valid URI"
    end
    write_env(u.host || "localhost", u.port || 5432, user, pass)
  '
}

mlr_doc_test_database_name() {
  ruby -ryaml -e '
    cfg = YAML.load_file("test/dummy/config/database.yml", aliases: true)
    puts cfg.fetch("test").fetch("database")
  '
}

# Prints the database name Rails' ConnectionUrlResolver would use for
# DATABASE_URL, or nothing when it is unset or blank.
# Opaque URLs (postgres:name) use the opaque part, which wins over a query
# parameter. Otherwise a query parameter named database wins over the path.
# The name is percent-decoded. Unparseable URLs exit non-zero with a fixed
# message (the URL is not printed).
mlr_doc_database_url_name() {
  ruby -ruri -e '
    raw = ENV["DATABASE_URL"]
    exit 0 if raw.nil? || raw.empty?

    parser = URI::RFC2396_Parser.new
    begin
      uri = parser.parse(raw)
    rescue StandardError
      abort "DATABASE_URL is not a valid URI"
    end

    query_str = nil
    opaque = nil
    if uri.opaque
      opaque, query_str = uri.opaque.split("?", 2)
    else
      query_str = uri.query
    end

    query = {}
    (query_str || "").split("&").each do |pair|
      next if pair.empty?
      key, value = pair.split("=", 2)
      query[key] = value
    end

    if !opaque.nil?
      name = opaque
    elsif query.key?("database")
      name = query["database"]
    else
      name = uri.path.to_s.delete_prefix("/")
    end

    # Rails compact_blank runs on the raw value, then percent-decodes what remains.
    # "%20" is kept and becomes a space; a raw blank string is dropped.
    if !name.is_a?(String) || name.empty? || name.match?(/\A[[:space:]]*\z/)
      exit 0
    end
    begin
      name = parser.unescape(name)
    rescue StandardError
      abort "DATABASE_URL is not a valid URI"
    end
    puts name
  '
}

# Fixed-string redaction. Secrets are read from the environment (never argv)
# so values with any characters can be replaced safely. Also redacts JSON
# "password" values, any *_PASSWORD= assignment, and pwd=/pwd: through
# the end of the line.
mlr_doc_redact() {
  ruby -ruri -e '
    def remember(list, value)
      return if value.nil? || value.empty?
      list << value.dup.force_encoding(Encoding::ASCII_8BIT)
    end

    STDIN.binmode
    STDOUT.binmode
    blob = STDIN.read.to_s.force_encoding(Encoding::ASCII_8BIT)
    urls = []
    passwords = []
    remember(urls, ENV["DATABASE_URL"])
    remember(passwords, ENV["PGPASSWORD"])

    raw_url = ENV["DATABASE_URL"]
    if raw_url && !raw_url.empty?
      parses = []
      begin
        parses << URI::RFC2396_Parser.new.parse(raw_url)
      rescue StandardError
      end
      begin
        parses << URI(raw_url)
      rescue StandardError
      end
      parser = URI::RFC2396_Parser.new
      parses.each do |uri|
        pass = uri.password
        next if pass.nil? || pass.empty?
        remember(passwords, pass)
        begin
          remember(passwords, parser.unescape(pass))
        rescue StandardError
        end
        begin
          remember(passwords, URI.decode_www_form_component(pass))
        rescue StandardError
        end
      end
    end

    token = "\x00".b
    secrets = urls + passwords
    while blob.include?(token) || secrets.any? { |s| s.include?(token) }
      token += "\x00".b
    end

    urls.uniq.sort_by { |s| -s.bytesize }.each { |s| blob.gsub!(s, token) }
    blob.gsub!(%r{postgres(?:ql)?://[^\s"\x27]+}n, token)
    # Quoted JSON first so a later same-line assignment cannot hide the value.
    json_pw = /("password"[ \t]*:[ \t]*")(?:\\.|[^"\\\n])*(")/in
    blob.gsub!(json_pw) { ($1 + token + $2).force_encoding(Encoding::ASCII_8BIT) }
    key_re = /(^|[^\w])(password|pgpassword|database_url)(\s*[:=]\s*)[^\n]*/in
    blob.gsub!(key_re) { ($1 + $2 + $3 + token).force_encoding(Encoding::ASCII_8BIT) }
    env_pw = /(^|[^\w])(\w+_password)([ \t]*=[ \t]*)[^\n]*/in
    blob.gsub!(env_pw) { ($1 + $2 + $3 + token).force_encoding(Encoding::ASCII_8BIT) }
    pwd_re = /(^|[^\w])(pwd)([ \t]*[:=][ \t]*)[^\n]*/in
    blob.gsub!(pwd_re) { ($1 + $2 + $3 + token).force_encoding(Encoding::ASCII_8BIT) }
    passwords.uniq.sort_by { |s| -s.bytesize }.each { |s| blob.gsub!(s, token) }
    blob.gsub!(token, "[REDACTED]".b)
    STDOUT.write(blob)
  '
}

mlr_doc_log_tail() {
  local logfile="$1"
  tail -30 "$logfile" | mlr_doc_redact | sed 's/^/   | /'
}

# Writes query rows for a public relation, or the line "missing" when it does not exist.
# Connection failures stay probe errors. rel is one of the two catalog tables below.
mlr_doc_capture_relation() {
  local test_db="$1"
  local rel="$2"
  local query="$3"
  local outfile="$4"
  local errfile="$5"
  local snap_err="$6"
  local flag

  case "$rel" in
    schema_migrations | ar_internal_metadata) ;;
    *)
      printf '%s\n' 'snapshot probe failed' >"$errfile"
      return 1
      ;;
  esac

  if ! flag="$(psql -X -q -d "$test_db" -v ON_ERROR_STOP=1 -tAc \
    "SELECT CASE WHEN to_regclass('public.${rel}') IS NULL THEN 'missing' ELSE 'present' END" \
    2>"$snap_err")"; then
    mlr_doc_copy_err "$snap_err" "$errfile"
    return 1
  fi
  flag="$(printf '%s' "$flag" | tr -d '[:space:]')"
  if [ "$flag" = "missing" ]; then
    printf '%s\n' missing >"$outfile"
    return 0
  fi
  if [ "$flag" != "present" ]; then
    printf '%s\n' 'snapshot probe failed' >"$errfile"
    return 1
  fi
  if ! psql -X -q -d "$test_db" -v ON_ERROR_STOP=1 -tAc "$query" >"$outfile" 2>"$snap_err"; then
    mlr_doc_copy_err "$snap_err" "$errfile"
    return 1
  fi
}

# `cat "$src" >"$dest"` truncates dest before reading when they are the same file.
mlr_doc_copy_err() {
  local src="$1"
  local dest="$2"
  if [ "$src" -ef "$dest" ]; then
    return 0
  fi
  cat "$src" >"$dest"
}

# Writes "absent" or a sha256 hex digest to $1. Fails (non-zero) on probe/connection errors.
# A missing schema_migrations or ar_internal_metadata relation is part of the snapshot
# ("missing"), not a probe error. Counts miss a delete+reinsert of the same demo rows,
# so each public table also contributes md5(string_agg(row text)) in deterministic order.
# Every public sequence contributes last_value and is_called, so an insert/delete that
# only advances a sequence still changes the digest.
# Every psql call uses -X (ignore ~/.psqlrc and $PSQLRC) and -q so timing chatter
# and startup messages cannot change the captured rows. ON_ERROR_STOP is set on each call.
mlr_doc_test_db_snapshot() {
  local outfile="$1"
  local test_db="$2"
  local errfile="$3"
  local snap_err="$tmp/mlr-doc-snapshot-probe.err"
  local body quoted row tbl

  export MLR_DOC_TEST_DB="$test_db"

  if command -v psql >/dev/null 2>&1; then
    if ! psql -X -q -d postgres -v ON_ERROR_STOP=1 -tAc "SELECT 1" >"$snap_err" 2>&1; then
      mlr_doc_copy_err "$snap_err" "$errfile"
      return 1
    fi
    if ! psql -X -q -d postgres -v ON_ERROR_STOP=1 -tAc \
      "SELECT 1 FROM pg_database WHERE datname = '${test_db}'" >"$tmp/mlr-doc-db-exists.txt" 2>"$snap_err"; then
      mlr_doc_copy_err "$snap_err" "$errfile"
      return 1
    fi
    if [ "$(tr -d '[:space:]' <"$tmp/mlr-doc-db-exists.txt")" != "1" ]; then
      printf '%s\n' absent >"$outfile"
      return 0
    fi
    if ! mlr_doc_capture_relation "$test_db" schema_migrations \
      "SELECT version FROM schema_migrations ORDER BY version" \
      "$tmp/mlr-doc-migrations.txt" "$errfile" "$snap_err"; then
      return 1
    fi
    if ! mlr_doc_capture_relation "$test_db" ar_internal_metadata \
      "SELECT key, value, created_at, updated_at FROM ar_internal_metadata ORDER BY key" \
      "$tmp/mlr-doc-metadata.txt" "$errfile" "$snap_err"; then
      return 1
    fi
    if ! psql -X -q -d "$test_db" -v ON_ERROR_STOP=1 -tAc \
      "SELECT tablename FROM pg_tables WHERE schemaname = 'public' ORDER BY tablename" \
      >"$tmp/mlr-doc-tables.txt" 2>"$snap_err"; then
      mlr_doc_copy_err "$snap_err" "$errfile"
      return 1
    fi
    body="$tmp/mlr-doc-snapshot-body.txt"
    {
      printf '%s\n' 'schema_migrations'
      cat "$tmp/mlr-doc-migrations.txt"
      printf '%s\n' 'ar_internal_metadata'
      cat "$tmp/mlr-doc-metadata.txt"
    } >"$body"
    while IFS= read -r tbl; do
      [ -z "$tbl" ] && continue
      quoted="${tbl//\"/\"\"}"
      if ! row="$(psql -X -q -d "$test_db" -v ON_ERROR_STOP=1 -tA -F "$(printf '\t')" -c \
        "SELECT COUNT(*)::bigint, md5(COALESCE(string_agg(t::text, chr(10) ORDER BY t::text), '')) FROM public.\"${quoted}\" t" \
        2>"$snap_err")"; then
        mlr_doc_copy_err "$snap_err" "$errfile"
        return 1
      fi
      printf '%s\t%s\n' "$tbl" "$row" >>"$body"
    done <"$tmp/mlr-doc-tables.txt"
    if ! psql -X -q -d "$test_db" -v ON_ERROR_STOP=1 -tA -F "$(printf '\t')" \
      >"$tmp/mlr-doc-sequences.txt" 2>"$snap_err" <<'SQL'
SELECT format(
  'SELECT %L, last_value, is_called FROM %I.%I',
  sequencename, schemaname, sequencename
)
FROM pg_sequences
WHERE schemaname = 'public'
ORDER BY sequencename
\gexec
SQL
    then
      mlr_doc_copy_err "$snap_err" "$errfile"
      return 1
    fi
    {
      printf '%s\n' 'sequences'
      cat "$tmp/mlr-doc-sequences.txt"
    } >>"$body"
    if ! sha256sum "$body" >"$tmp/mlr-doc-snapshot.sha"; then
      printf '%s\n' 'snapshot digest failed' >"$errfile"
      return 1
    fi
    awk '{print $1}' "$tmp/mlr-doc-snapshot.sha" >"$outfile"
    return 0
  fi

  # shellcheck disable=SC2016 # $1 is a query placeholder, not a shell expansion
  if ! bundle exec ruby -rpg -rdigest -e '
    test_db = ENV.fetch("MLR_DOC_TEST_DB")
    conn = PG.connect(
      host: ENV.fetch("PGHOST"),
      port: ENV.fetch("PGPORT", "5432"),
      user: ENV.fetch("PGUSER"),
      password: ENV.fetch("PGPASSWORD"),
      dbname: "postgres"
    )
    exists = conn.exec_params("SELECT 1 FROM pg_database WHERE datname = $1", [test_db]).ntuples.positive?
    conn.close
    unless exists
      puts "absent"
      exit 0
    end
    conn = PG.connect(
      host: ENV.fetch("PGHOST"),
      port: ENV.fetch("PGPORT", "5432"),
      user: ENV.fetch("PGUSER"),
      password: ENV.fetch("PGPASSWORD"),
      dbname: test_db
    )
    parts = []
    def relation_present(conn, name)
      !conn.exec_params("SELECT to_regclass($1) AS rel", [name]).first["rel"].nil?
    end
    if relation_present(conn, "public.schema_migrations")
      mig = conn.exec("SELECT version FROM schema_migrations ORDER BY version")
      parts << "schema_migrations\n" + mig.map { |r| r["version"] }.join("\n")
    else
      parts << "schema_migrations\nmissing"
    end
    if relation_present(conn, "public.ar_internal_metadata")
      meta = conn.exec("SELECT key, value, created_at, updated_at FROM ar_internal_metadata ORDER BY key")
      parts << "ar_internal_metadata\n" + meta.map { |r| r.values.join("\t") }.join("\n")
    else
      parts << "ar_internal_metadata\nmissing"
    end
    tables = conn.exec_params(
      "SELECT tablename FROM pg_tables WHERE schemaname = $1 ORDER BY tablename",
      ["public"]
    )
    empty_md5 = Digest::MD5.hexdigest("")
    tables.each do |row|
      tbl = row["tablename"]
      q = "SELECT COUNT(*)::bigint AS c, md5(string_agg(t::text, chr(10) ORDER BY t::text)) AS h FROM public." + conn.quote_ident(tbl) + " t"
      got = conn.exec(q).first
      h = got["h"] || empty_md5
      parts << "#{tbl}\t#{got["c"]}\t#{h}"
    end
    seq_lines = []
    conn.exec_params(
      "SELECT sequencename FROM pg_sequences WHERE schemaname = $1 ORDER BY sequencename",
      ["public"]
    ).each do |row|
      name = row["sequencename"]
      got = conn.exec(
        "SELECT last_value::text AS last_value, is_called FROM " +
        conn.quote_ident("public") + "." + conn.quote_ident(name)
      ).first
      called = got["is_called"]
      called = "t" if called == true || called == "t" || called == "true"
      called = "f" if called == false || called == "f" || called == "false"
      seq_lines << [name, got["last_value"].to_s, called].join("\t")
    end
    parts << (["sequences"] + seq_lines).join("\n")
    conn.close
    puts Digest::SHA256.hexdigest(parts.join("\n"))
  ' >"$outfile" 2>"$snap_err"; then
    mlr_doc_copy_err "$snap_err" "$errfile"
    return 1
  fi
}

mlr_doc_assert_pass() {
  local logfile="$1"
  local pass_label="$2"
  local missing=0 pattern mlr_doc_pwd

  for pattern in "docs/gm6_mlr_savings_methodology.md." "savings=$"; do
    if ! grep -qF -- "$pattern" "$logfile"; then
      printf '   FAIL: pass %s expected output missing: %s\n' "$pass_label" "$pattern"
      missing=1
    fi
  done

  mlr_doc_pwd="$(grep '^MLR_DOC_PWD=' "$logfile" | tail -1)"
  if [ "$mlr_doc_pwd" != "MLR_DOC_PWD=$ROOT" ]; then
    printf '   FAIL: pass %s must end in repo root (expected MLR_DOC_PWD=%s, got %s)\n' \
      "$pass_label" "$ROOT" "${mlr_doc_pwd#MLR_DOC_PWD=}"
    missing=1
  fi

  return "$missing"
}

# Prints line numbers whose code (fenced blocks or inline spans) invokes
# bin/rails without RAILS_ENV=development on that command. The line text is
# not printed. Exits non-zero only when the file cannot be scanned.
mlr_doc_rails_env_violations() {
  ruby - "$1" <<'RUBY'
def strip_shell_comment(text)
  out = +""
  in_single = false
  in_double = false
  i = 0
  while i < text.length
    ch = text[i]
    if ch == "\\" && !in_single && i + 1 < text.length
      out << ch << text[i + 1]
      i += 2
      next
    end
    if ch == "'" && !in_double
      in_single = !in_single
      out << ch
      i += 1
      next
    end
    if ch == '"' && !in_single
      in_double = !in_double
      out << ch
      i += 1
      next
    end
    break if ch == "#" && !in_single && !in_double
    out << ch
    i += 1
  end
  out
end

def split_commands(text)
  parts = []
  buf = +""
  in_single = false
  in_double = false
  i = 0
  while i < text.length
    ch = text[i]
    if ch == "\\" && !in_single && i + 1 < text.length
      buf << ch << text[i + 1]
      i += 2
      next
    end
    if ch == "'" && !in_double
      in_single = !in_single
      buf << ch
      i += 1
      next
    end
    if ch == '"' && !in_single
      in_double = !in_double
      buf << ch
      i += 1
      next
    end
    if !in_single && !in_double
      if text[i, 2] == "&&" || text[i, 2] == "||"
        parts << buf
        buf = +""
        i += 2
        next
      end
      if ch == ";" || ch == "|" || ch == "\n"
        parts << buf
        buf = +""
        i += 1
        next
      end
    end
    buf << ch
    i += 1
  end
  parts << buf
  parts
end

def rails_env_value(before)
  found = nil
  before.scan(/RAILS_ENV=(?:"([^"]*)"|'([^']*)'|(\S+))/) do |dbl, sgl, bare|
    found = dbl || sgl || bare
  end
  found
end

def boundary?(ch)
  return true if ch.nil?
  return true if ch.match?(/[[:space:]]/)
  ";|&(`\"'".include?(ch)
end

def command_ok?(command)
  idx = 0
  needle = "bin/rails"
  while (i = command.index(needle, idx))
    prev = i.zero? ? nil : command[i - 1]
    if boundary?(prev)
      return false unless rails_env_value(command[0...i]) == "development"
    end
    idx = i + needle.length
  end
  true
end

def text_ok?(text)
  split_commands(strip_shell_comment(text)).all? { |cmd| command_ok?(cmd) }
end

path = ARGV.fetch(0)
fence = false
File.foreach(path, mode: "r:UTF-8").with_index(1) do |line, lineno|
  body = line.sub(/\r?\n\z/, "")
  if body.match?(/\A\s*```/)
    fence = !fence
    next
  end
  texts = []
  if fence
    texts << body
  else
    pos = 0
    while (match = body.match(/`([^`]*)`/, pos))
      texts << match[1]
      pos = match.end(0)
    end
  end
  texts.each do |text|
    next if text_ok?(text)
    puts lineno
    break
  end
end
RUBY
}

check_mlr_doc() {
  local name="mlr-doc"
  if [ "$only" != "all" ] && [ "$only" != "$name" ]; then return 0; fi

  local script="$tmp/mlr-doc-reproduce.sh"
  local doc="docs/gm6_mlr_savings_methodology.md"
  local log_a="$tmp/mlr-doc-pass-a.log"
  local log_b="$tmp/mlr-doc-pass-b.log"
  local snapshot_before="$tmp/mlr-doc-snapshot-before.txt"
  local snapshot_after="$tmp/mlr-doc-snapshot-after.txt"
  local snapshot_err="$tmp/mlr-doc-snapshot.err"
  local pg_env="$tmp/mlr-doc-pg.env"
  local test_db missing=0 assertions=0 url_db url_err
  local static_failed=0 pass_failed=0 lineno violations

  printf '== smoke: %s\n' "$name"

  # Every bin/rails invocation in a code block or inline span must carry
  # RAILS_ENV=development. The reproduce block is only the first bash fence,
  # so later fences and inline cms:* lines are checked here. A violation is
  # reported and the run still continues, so a test-database write is also
  # caught by the snapshot comparison below.
  if ! violations="$(mlr_doc_rails_env_violations "$doc" 2>"$tmp/mlr-doc-rails-env.err")"; then
    printf '   FAIL: could not scan %s for bin/rails commands\n' "$doc"
    mlr_doc_redact <"$tmp/mlr-doc-rails-env.err" | sed 's/^/   | /'
    failures=$((failures + 1))
    return 0
  fi
  while IFS= read -r lineno; do
    [ -n "$lineno" ] || continue
    printf '   FAIL: %s:%s: bin/rails must set RAILS_ENV=development\n' "$doc" "$lineno"
    static_failed=1
  done <<< "$violations"

  if ! awk '
    BEGIN { after = 0; capturing = 0; got = 0 }
    /\*\*Reproduce:\*\*/ { after = 1; next }
    after && !got && /^```bash$/ { capturing = 1; got = 1; next }
    capturing && /^```$/ { capturing = 0; exit 0 }
    capturing { print }
    END { if (!got) exit 1 }
  ' "$doc" >"$tmp/mlr-doc-block.txt"; then
    printf '   FAIL: no ```bash block after **Reproduce:** in %s\n' "$doc"
    failures=$((failures + 1))
    return 0
  fi

  if [ ! -s "$tmp/mlr-doc-block.txt" ]; then
    printf '   FAIL: empty ```bash block after **Reproduce:** in %s\n' "$doc"
    failures=$((failures + 1))
    return 0
  fi

  if ! test_db="$(mlr_doc_test_database_name)"; then
    printf '   FAIL: could not read test database name from test/dummy/config/database.yml\n'
    failures=$((failures + 1))
    return 0
  fi

  url_err="$tmp/mlr-doc-url.err"
  if ! url_db="$(mlr_doc_database_url_name 2>"$url_err")"; then
    printf '   FAIL: could not parse DATABASE_URL server parameters\n'
    mlr_doc_redact <"$url_err" | sed 's/^/   | /'
    failures=$((failures + 1))
    return 0
  fi
  # DATABASE_URL overrides RAILS_ENV. A URL Rails would open as the test
  # database would run the reproduce block against it — refuse before any probe.
  if [ -n "$url_db" ] && [ "$url_db" = "$test_db" ]; then
    printf '   FAIL: DATABASE_URL names the test database\n'
    failures=$((failures + 1))
    return 0
  fi

  if ! mlr_doc_write_pg_env "$pg_env" 2>"$tmp/mlr-doc-pg.err"; then
    printf '   FAIL: could not parse DATABASE_URL server parameters\n'
    mlr_doc_redact <"$tmp/mlr-doc-pg.err" | sed 's/^/   | /'
    failures=$((failures + 1))
    return 0
  fi
  # shellcheck source=/dev/null
  set -a && . "$pg_env" && set +a

  if ! mlr_doc_test_db_snapshot "$snapshot_before" "$test_db" "$snapshot_err"; then
    printf '   FAIL: test database snapshot before reproduce (probe error)\n'
    mlr_doc_redact <"$snapshot_err" | sed 's/^/   | /'
    failures=$((failures + 1))
    return 0
  fi
  assertions=$((assertions + 1))

  {
    printf '%s\n' '#!/usr/bin/env bash'
    printf '%s\n' 'set -e'
    cat "$tmp/mlr-doc-block.txt"
    # shellcheck disable=SC2016 # $PWD expands in the generated script, not here
    printf '%s\n' 'echo "MLR_DOC_PWD=$PWD"'
  } >"$script"
  chmod +x "$script"

  if ! env RAILS_ENV=test bash -e "$script" >"$log_a" 2>&1; then
    printf '   FAIL: reproduce block pass A (DATABASE_URL inherited) exited non-zero\n'
    mlr_doc_log_tail "$log_a"
    pass_failed=1
  elif ! mlr_doc_assert_pass "$log_a" A; then
    missing=1
  else
    assertions=$((assertions + 3))
  fi

  # A failed pass used to return before the after-snapshot, so a test-database
  # change was reported only as that pass failure. Still run pass B when pass A
  # exited 0, then always snapshot if the before-snapshot succeeded.
  if [ "$pass_failed" -eq 0 ]; then
    # PGPASSWORD is already exported by set -a. Passing it as an env(1)
    # argument would put the secret on the process command line.
    if ! env -u DATABASE_URL RAILS_ENV=test \
      PGHOST="$PGHOST" PGPORT="$PGPORT" PGUSER="$PGUSER" \
      bash -e "$script" >"$log_b" 2>&1; then
      printf '   FAIL: reproduce block pass B (DATABASE_URL unset, TCP via PG*) exited non-zero\n'
      mlr_doc_log_tail "$log_b"
      pass_failed=1
    elif ! mlr_doc_assert_pass "$log_b" B; then
      missing=1
    else
      assertions=$((assertions + 3))
    fi
  fi

  if ! mlr_doc_test_db_snapshot "$snapshot_after" "$test_db" "$snapshot_err"; then
    printf '   FAIL: test database snapshot after reproduce (probe error)\n'
    mlr_doc_redact <"$snapshot_err" | sed 's/^/   | /'
    failures=$((failures + 1))
    return 0
  fi
  assertions=$((assertions + 1))

  if ! cmp -s "$snapshot_before" "$snapshot_after"; then
    printf '   FAIL: test database %s changed (snapshot before reproduce != after)\n' "$test_db"
    missing=1
  else
    assertions=$((assertions + 1))
  fi

  if [ "$static_failed" -eq 1 ] || [ "$pass_failed" -eq 1 ] || [ "$missing" -eq 1 ]; then
    # Pass non-zero already printed its own log tail. Assertion and snapshot
    # mismatches still show both passes when those passes actually ran.
    if [ "$missing" -eq 1 ] && [ "$pass_failed" -eq 0 ]; then
      printf '   log tail pass A:\n'
      mlr_doc_log_tail "$log_a"
      printf '   log tail pass B:\n'
      mlr_doc_log_tail "$log_b"
    fi
    failures=$((failures + 1))
  else
    printf '   ok (%s assertions)\n' "$assertions"
  fi
}

# Narrated PRC happy path: referral walks the state machine to authorized with
# a funded obligation. Runs first on purpose: it shares the Broken Rock
# facility with the overlay, so the overlay's reset must clear what it leaves.
check prc bin/demo-prc \
  "1. Patient registration" \
  "3. Eligibility review + tribal enrollment verification" \
  "referral.approve_management!" \
  "funds_available=true" \
  "-> status=authorized" \
  "Checklist:      100.0% complete"

# Stock-FHIR overlay: both synthetic clinics ingest over generic FHIR, PRC
# eligibility auto-populates, and MLR repricing reports dollars recovered.
check overlay bin/demo-overlay \
  "Broken Rock Clinic" \
  "Tallgrass Clinic" \
  "Corvid::Adapters::FhirAdapter" \
  "PRC eligibility: checklist" \
  "Claims priced (clear): 10" \
  "TOTAL \$ RECOVERED across the consortium: \$" \
  "CEHRT-SAFE OVERLAY"

# Governed migration: consented patient relays, non-consented patient halts,
# both are recorded as audit Determinations.
check prc-migration bin/demo-prc-migration \
  "Transport: STUB" \
  "-> MIGRATED" \
  "-> HALTED    Data Governance Board consent not granted" \
  "determination approved" \
  "determination denied"

check_mlr_doc

if [ "$failures" -gt 0 ]; then
  printf '\ndemo-smoke: %d demo(s) failed\n' "$failures"
  exit 1
fi
if [ "$only" = "all" ]; then
  printf '\ndemo-smoke: all demos green\n'
else
  printf '\ndemo-smoke: %s green\n' "$only"
fi
